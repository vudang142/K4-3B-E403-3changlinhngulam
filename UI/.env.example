# AI Attendance - Environment Variables
# Copy this file to .env.local and fill in your values

# Gemini API Key (get from https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# Required in production. Generate a long, random secret and never expose it to the browser.
ATTENDANCE_TOKEN_SECRET=replace-with-a-long-random-secret

# Optional in local development. Set this to an address student phones can reach.
# If omitted, PresenceAI automatically tries the machine's private LAN address.
NEXT_PUBLIC_APP_URL=http://192.168.1.100:3000
